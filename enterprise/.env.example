# Taro Enterprise configuration. Copy to infra/production/.env (or your secret store) and fill
# in. Never commit the filled-in file. Every variable is described in docs/operations/DEPLOYMENT.md.

# development | staging | production
TARO_ENV=production
# https origins of the two apps
TARO_PUBLIC_URL=https://portal.example.com
TARO_OPS_URL=https://ops.example.com
# 64 random hex digits: openssl rand -hex 32
TARO_SECRET_KEY=
# the first platform administrator (made platform_admin on their first sign-in, while there is none)
TARO_BOOTSTRAP_ADMIN_EMAIL=

# sign-in mail (required outside development): smtps://user:password@smtp.example.com:465
TARO_SMTP_URL=
TARO_MAIL_FROM=Taro Enterprise <no-reply@example.com>

# Google sign-in (optional; both or neither). Redirect URIs to register at Google:
#   https://portal.example.com/api/v1/auth/google/callback
#   https://ops.example.com/api/v1/auth/google/callback
TARO_GOOGLE_CLIENT_ID=
TARO_GOOGLE_CLIENT_SECRET=

# Stripe (optional: without it, rentals cannot be paid outside development). Test keys only,
# unless TARO_STRIPE_LIVE=1 is set on purpose in production.
TARO_STRIPE_SECRET_KEY=
TARO_STRIPE_WEBHOOK_SECRET=
TARO_STRIPE_LIVE=

# the provider adapter (only "mock" is implemented today), and the mock's size
TARO_PROVIDER=mock
TARO_MOCK_MACS=8
TARO_MOCK_DELAY_SECS=8

# Docker Compose and Caddy
POSTGRES_PASSWORD=
PORTAL_HOST=portal.example.com
OPS_HOST=ops.example.com
OPS_ALLOWED_CIDRS=203.0.113.0/24
ACME_EMAIL=ops@example.com
